---
import { site } from "../site";
const { title, description = "" } = Astro.props;
const t = site.theme;
const nav = site.nav;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<html lang="el" style={`--wine:${t.wine};--dark:${t.dark};--rose:${t.rose};--cream:${t.cream};--ink:${t.ink};--muted:${t.muted};--line:${t.line};--shadow:${t.shadow};--radius${t.radius};--max:${t.max};`}>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content={site.desc}>
        <meta name="theme-color" content={site.color}>
        <title>{title} | Youweekly</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap">
    </head>
    <body>
        <div class="topline">WINE DESTINATIONS FESTIVE EXPERIENCE by TASOS DOUSIS MEDIA</div>
        <header class="site-header">
            <nav class="nav container">
                <a class="brand" href="https://www.youweekly.gr/" aria-label="Youweekly αρχική">youweekly<span>.gr</span></a>
                <div class="nav-links">
                    {nav.map(({title, link}) => 
                        <a href={link}>{title}</a>
                    )}
                </div>
            </nav>
        </header>
        <main id="top">
            <slot />
        </main>
        <footer>
            <div class="container">
                Youweekly.gr • Wine Destinations • {site.title}<br>Οι πληροφορίες επίσκεψης χρειάζονται επιβεβαίωση πριν από την αναχώρηση.
            </div>
        </footer>
    </body>
</html>
<style is:global>
    *{
        box-sizing: border-box;
    }
    html {
        scroll-behavior: smooth;
    }
    body {
        margin: 0;
        color: var(--ink);
        font-family: Manrope, system-ui, sans-serif;
        line-height: 1.7;
    }
    img {
        display: block;
        width: 100%;
    }
    a {
        color: inherit;
    }
    .container {
        width: min(calc(100% - 38px), var(--max));
        margin: auto;
    }
    .eyebrow {
        margin: 0 0 10px;
        color: var(--rose);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }
    h1,h2,h3 {
        margin: 0;
        font-family: "Playfair Display", Georgia, serif;
        line-height: 1.12;
    }
    h2 {
        font-size: clamp(2rem, 4vw, 3.45rem);
    }
    h3 {
        font-size: 1.45rem;
    }
    p {
        margin: 0 0 1em;
    }
    .topline {
        padding: 7px 16px;
        color: #fff;
        background: var(--dark);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-align: center;
        text-transform: uppercase;
    }
    .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(15px);
    }
    .nav {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
    }
    .nav-links {
        display: flex;
        gap: 22px;
        font-size: 0.85rem;
        font-weight: 700;
    }
    .nav-links a {
        text-decoration: none;
    }
    section {
        padding: 100px 0;
    }
    .section-soft {
        background-color: var(--cream);
    }
    .section-dark {
        color: #fff;
        background-color: var(--dark);
    }
    .section-head {
        max-width: 850px;
        margin-bottom: 42px;
    }
    .section-head p:last-child {
        margin-top: 18px;
        color: var(--muted);
    }
    .section-dark .section-head p:last-child {
        color: rgba(255, 255, 255, 0.72);
    }
    .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }
    .card {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: #fff;
        box-shadow: 0 10px 30px rgba(46, 17, 24, 0.06);
    }
    .card-body {
        padding: 25px;
    }
    .card-kicker {
        margin-bottom: 10px;
        color: var(--rose);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .card p {
        margin-top: 13px;
        color: var(--muted);
        font-size: 0.91rem;
    }
    .card ul {
        padding-left: 20px;
        color: var(--muted);
        font-size: 0.88rem;
    }
    .wide-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }
    footer {
        padding: 38px 0;
        background: #21070d;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
        font-size: 0.82rem;
    }
    @media (max-width: 850px) { 
       .nav-links {
            display: none;
        }
        .cards {
            grid-template-columns: repeat(2, 1fr);
        }
        .wide-grid {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 560px) {
        .facts-grid,
        .cards,
        .pill-grid,
        .tips {
            grid-template-columns: 1fr;
        }
        .fact {
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }
        section {
            padding: 72px 0;
        }
        .hero-content {
            padding: 90px 0 72px;
        }
    }
</style>