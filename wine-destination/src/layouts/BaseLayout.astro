---
import { site } from "../site";
const { title, description = "" } = Astro.props;
const t = site.theme;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<html lang="el">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content={site.desc}>
        <meta name="theme-color" content={site.color}>
        <title>{title} | Youweekly</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap">
    </head>
    <body>
        <div class="topline">WINE DESTINATIONS FESTIVE EXPERIENCE by TASOS DOUSIS MEDIA</div>
        <header class="site-header"><nav class="nav container"><a class="brand" href="#top" aria-label="Youweekly αρχική">youweekly<span>.gr</span></a><div class="nav-links"><a href="#destination">Προορισμός</a><a href="#wineries">Οινοποιεία</a><a href="#route">Διαδρομή</a><a href="#tips">Tips</a></div></nav></header>
        <main id="top">
            <slot />
        </main>
        <footer>
            <div class="container">
                Youweekly.gr • Wine Destinations • {site.title}<br>Οι πληροφορίες επίσκεψης χρειάζονται επιβεβαίωση πριν από την αναχώρηση.
            </div>
        </footer>
    </body>
</html>