---
interface Feature {
    h3: string;
    content: string;
}
interface Props {
    h2: string;
    features: Feature[];
}
const {h2, features} = Astro.props;
---

<section id="experience">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Γεύση & φιλοξενία</p>
            <h2>{h2}</h2>
        </div>
        <div class="wide-grid">
            {features.map(({h3, content}) => 
                <article>
                    <h3>{h3}</h3>
                    <p>{content}</p>
                </article>
            )}
        </div>
    </div>
</section>

<style>
    .feature,
    .day {
        padding: 30px;
        border-radius: var(--radius);
        background: #fff;
        box-shadow: var(--shadow);
    }
    .feature p,
    .day li {
        color: var(--muted);
    }
    .day ul {
        padding-left: 20px;
    }
</style>