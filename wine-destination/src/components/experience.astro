---
import { parseInlineHtml } from "../utils/formatters";

interface Feature {
    h3: string;
    content?: string;
    list?: string[];
    image: string;
    alt: string;
    eyebrow: string;
}
interface Props {
    h2: string;
    features: Feature[];
}
const {h2, features} = Astro.props;
---

<section id="experience">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Γεύση & φιλοξενία</p>
            <h2>{h2}</h2>
        </div>
        <div class="cards">
            {features.map(({h3, content, list, image, alt, eyebrow}) => 
                <article class="card">
                    <img class="card-image" src={image} alt={alt} />
                    <div class="card-body">
                        <div class="card-kicker">{eyebrow}</div>
                        <h3>{h3}</h3>
                        {content && (
                            <p>
                                {parseInlineHtml(content).map((part) => {
                                    if (part.type === "bold") {
                                        return <b>{part.content}</b>;
                                    }

                                    if (part.type === "link") {
                                        return <a {...part.attributes}>{part.content}</a>;
                                    }

                                    return part.content;
                                })}
                            </p>
                        )}
                        {list && (
                            <ul class="list-clean">
                                {list.map((item) => (
                                    <li>
                                        {parseInlineHtml(item).map((part) => {
                                            if (part.type === "bold") {
                                                return <b>{part.content}</b>;
                                            }

                                            if (part.type === "link") {
                                                return <a {...part.attributes}>{part.content}</a>;
                                            }

                                            return part.content;
                                        })}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </article>
            )}
        </div>
    </div>
</section>

<style>
    #experience .cards {
        grid-template-columns: repeat(2, 1fr);
    }

</style>