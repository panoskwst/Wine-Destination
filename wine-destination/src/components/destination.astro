---
const {image, alt, h2, content, quote} = Astro.props;
---

<section class="section" id="destination">
    <div class="container intro">
        <img src={image} alt={alt}>
        <div class="copy">
            <p class="eyebrow">
                Ο Προορισμός
            </p>
            <h2>
                {h2}
            </h2>
            <p>
                {content}
            </p>
            <div class="quote">
                {quote}
            </div>
        </div>
    </div>
</section>