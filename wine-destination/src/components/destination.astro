---
import { parseInlineHtml } from "../utils/formatters";

const {image, alt, h2, content, quote} = Astro.props;
---

<section class="section" id="destination">
    <div class="container intro">
        <img src={image} alt={alt}>
        <div class="copy">
            <p class="eyebrow">Ο Προορισμός</p>
            <h2>{h2}</h2>
            <p>{content}</p>
            <div class="quote">
                {quote && (
                    <p>
                        {parseInlineHtml(quote).map((part) => {
                            if (part.type === "bold") {
                                return <b>{part.content}</b>;
                            }

                            if (part.type === "link") {
                                return <a {...part.attributes}>{part.content}</a>;
                            }

                            return part.content;
                        })}
                    </p>
                )}
            </div>
        </div>
    </div>
</section>

<style>
    .intro {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 70px;
        align-items: center;
    }
    .intro img {
        height: 590px;
        object-fit: cover;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }
    .copy p {
        color: var(--muted);
    }
    .quote {
        padding: 22px 25px;
        border-left: 4px solid var(--wine);
        background: var(--cream);
        font-family: "georgia";
        font-size: 1.22rem;
        font-style: italic;
    }
     @media (max-width: 850px) { 
        .intro {
            grid-template-columns: 1fr;
        }
        .intro img {
            height: 430px;
        }
    }
</style>