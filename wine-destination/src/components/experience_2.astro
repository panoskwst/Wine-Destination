---
interface Feature {
    h3: string;
    content?: string;
    list?: string[];
    image: string;
    eyebrow: string;
}
interface Props {
    h2: string;
    features: Feature[];
}
const {h2, features} = Astro.props;
---

<section id="experience">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Γεύση & φιλοξενία</p>
            <h2>{h2}</h2>
        </div>
        <div class="split">
            {features.map(({h3, content, list, image, eyebrow}) => 
                <article class="feature" style={`background-image: url(${image});`}>
                    <div class="feature-content">
                        <p class="eyebrow">{eyebrow}</p>
                        <h3>{h3}</h3>
                        {content && <p>{content}</p>}
                        {list && (
                            <ul class="list-clean">
                                {list.map((item) => (
                                    <li>
                                        {item.split(/(<b>.*?<\/b>)/g).map((part) =>
                                            part.startsWith("<b>") && part.endsWith("</b>")
                                                ? <b>{part.slice(3, -4)}</b> : part
                                        )}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </article>
            )}
        </div>
    </div>
</section>

<style>
    .split{
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
    }
    @media (max-width: 960px){
        .intro-grid, .split {
            grid-template-columns: 1fr;
        }
    }
    .feature {
        position: relative;
        min-height: 470px;
        display: flex;
        align-items: end;
        overflow: hidden;
        border-radius: var(--radius);
        color: #fff;
        background-position: center;
        background-size: cover;
    }
    .feature::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(rgba(26, 5, 10, .05), rgba(26, 5, 10, .65), rgba(26, 5, 10, .95));
    }
    .feature-content {
        position: relative;
        padding: 34px;
    }
    .feature p {
        max-width: 520px;
        margin-top: 13px;
        color: rgba(255, 255, 255, .82);
    }
    .eyebrow {
        margin: 0 0 10px;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .17em;
        text-transform: uppercase;
    }
    .feature ul.list-clean {
        margin: 18px 0 0;
        padding: 0;
        padding-left: 0;
        color: #fff;
        list-style: none;
    }
    .feature ul.list-clean li {
        padding: 10px 0;
        border-top: 1px solid rgba(255, 255, 255, .16);
    }

</style>