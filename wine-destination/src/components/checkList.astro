---
interface List {
    h3: string;
    content: string;
}
interface Props {
    h2: string;
    list: List[];
}
const {h2, list} = Astro.props;
---

<section>
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">
                Wine checklist
            </p>
            <h2>{h2}</h2>
        </div>
        <div class="cards">
            {list.map(({h3, content}) => 
                <article class="card">
                    <div class="card-body">
                        <h3>{h3}</h3>
                        <p>{content}</p>
                    </div>
                </article>
            )}
        </div>
    </div>
</section>