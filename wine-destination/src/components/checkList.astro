---
interface List {
    h3: string;
    content: string;
    pairing?: string; 
}
interface Props {
    h2: string;
    list: List[];
}
const {h2, list} = Astro.props;
---

<section>
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Wine checklist</p>
            <h2>{h2}</h2>
        </div>
        <div class="cards">
            {list.map(({h3, content, pairing}) => 
                <article class="card">
                    <div class="card-body">
                        <h3>{h3}</h3>
                        <p>{content}</p>
                        {pairing && <p class="wine-pairing"><strong>Με τι συνδυάζεται :</strong> {pairing}</p>}
                    </div>
                </article>
            )}
        </div>
    </div>
</section>

<style>
    .wine-pairing {
        color: var(--ink);
        margin-top: 17px;
        font-size: 0.86rem;
        border-left: 3px solid var(--rose);
        background: var(--cream);
        border-radius: 0px 12px 12px 0px;
        padding: 15px;
    }
</style>